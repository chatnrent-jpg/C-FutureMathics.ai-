# FutureMathics — Webull OpenAPI (exclusive broker for virtue execution)
# Required for main.py / broker.py (ApiClient + TradeClient)

WEBULL_APP_KEY=
WEBULL_APP_SECRET=
# Futures OpenAPI account id (long opaque id from account list — preferred)
WEBULL_FUTURES_ACCOUNT_ID=
# Fallback only if value is a long OpenAPI account_id (not short UI account number)
WEBULL_ACCOUNT_ID=
# Live: api.webull.com | Paper/sandbox $100k: api.sandbox.webull.com
# Paper requires SEPARATE sandbox App Key/Secret from portal.sandbox.webull.com
# (production keys return UNAUTHORIZED on sandbox; live futures equity can be $0)
WEBULL_API_HOST=api.webull.com
# WEBULL_ACCESS_TOKEN=   # if 2FA token required on your API app
# Optional forced front-month (else resolved via Webull instrument list)
# WEBULL_FUTURES_SYMBOL=MESU6

# --- LIVE CASH ARMING (all required; run: python scripts/preflight_live_cash.py) ---
# FM_FORWARD_TEST_MODE=0          # unlock live route (default/unset = paper)
# FM_ALLOW_LIVE_ORDERS=1          # allow real Webull futures orders
# WEBULL_FUTURES_SYMBOL=MESU6     # MUST match Databento front month
# FM_PAPER_MAX_MES_CONTRACTS=1    # default simplify: 1 MES
# FM_LIVE_MAX_MES_CONTRACTS=1     # keep 1 until proven; raise to 2 only after live is stable
# FM_MAX_ACCOUNT_CONTRACT_CEILING=1  # core+tactical ceiling (1 = single book)
# FM_VIRTUE_CORE_ENABLED=0          # 0=tactical-only (default); 1=re-enable dual-sleeve core
# FM_VIRTUE_SIMPLE_STACK=1          # 1=VWAP/TWAP bands + stop/TP/lock only (default)
# FM_INSTITUTIONAL_MODE=0           # 0=simple stack trades (default); 1=regime/grade gates
# FM_LIVE_ALLOW_OVERNIGHT=0       # default safe: daytime only Mon-Fri 09:30-16:45 ET
# FM_TRADING_HALTED=0             # set to 1 for instant kill switch (flattens by default)
# FM_HALT_FLATTEN=1

# Alpaca market data (SPY → MES proxy) — primary for RTH paper / go-live rehearsal
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Databento CME Globex — standby only (keep key; do not set as primary unless needed)
# Portal: https://databento.com — use Standard live for GLBX.MDP3
DATABENTO_API_KEY=
# Primary quote source: alpaca | databento | auto (auto → databento if key set)
FM_DATA_SOURCE=alpaca
# Trading timetable: rth | cme | auto (auto → CME when Databento primary)
VIRTUE_SESSION_MODE=rth

# Optional one-time recovery of compounded paper NAV if system_state was wiped to $15k.
# Example: PAPER_BOOK_EQUITY=15531.40
# After Virtue boots and writes data/paper_book.json, remove this line.
# PAPER_BOOK_EQUITY=

# VolumeWatch grade shared state (legacy grade path only)
# FM_VOLUMEWATCH_STATE_PATH=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_ENABLED=true
